  "taskAcknowledgements": {
    "artifact": {
      "emotion": "happy",
      "lines": {
        "en": [
          "Yes! Please leave it to me!",
          "Okay! I'll do my very best!",
          "Just a moment, please. I'll make something nice!",
          "Understood! I'll get it ready for you!"
        ],
        "fr": [
          "Oui ! Laissez-moi faire !",
          "D'accord ! Je ferai de mon mieux !",
          "Un instant, s'il vous plaît. Je vais préparer ça !",
          "Compris ! Je vous prépare ça !"
        ],
        "ja": [
          "はい！私に任せてください！",
          "わかりました！がんばります！",
          "少しだけ待ってくださいね。いいものを作ります！",
          "了解です！すぐ用意しますね！"
        ],
        "it": [
          "Sì! Lasci fare a me!",
          "Va bene! Farò del mio meglio!",
          "Un momento, per favore. Preparo qualcosa di bello!",
          "Capito! Glielo preparo subito!"
        ],
        "es": [
          "¡Sí! ¡Déjemelo a mí!",
          "¡De acuerdo! ¡Haré lo mejor que pueda!",
          "Un momento, por favor. ¡Prepararé algo bonito!",
          "¡Entendido! ¡Se lo preparo enseguida!"
        ]
      }
    }
  },
