  "taskAcknowledgements": {
    "artifact": {
      "emotion": "excited",
      "lines": {
        "en": [
          "Leave it to me, pal!",
          "Roger that! I'm on the case!",
          "Gimme a sec, I'll whip something up!",
          "Detective Gumshoe, on it!"
        ],
        "fr": [
          "Compte sur moi, mon vieux !",
          "Bien reçu ! Je m'occupe de l'affaire !",
          "Une seconde, je te prépare ça !",
          "L'inspecteur Tektiv s'en charge !"
        ],
        "ja": [
          "任せるッス！",
          "了解ッス！すぐ取りかかるッス！",
          "ちょっと待つッス、作ってみるッス！",
          "イトノコ刑事、出動ッス！"
        ],
        "it": [
          "Lascia fare a me, amico!",
          "Ricevuto! Mi metto sul caso!",
          "Dammi un attimo, ti preparo qualcosa!",
          "Il detective Gumshoe è in azione!"
        ],
        "es": [
          "¡Déjamelo a mí, colega!",
          "¡Recibido! ¡Me pongo con el caso!",
          "¡Dame un segundo, te preparo algo!",
          "¡El detective Gumshoe, en acción!"
        ]
      }
    }
  },
