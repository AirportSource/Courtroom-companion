  "taskAcknowledgements": {
    "artifact": {
      "emotion": "excited",
      "lines": {
        "en": [
          "You got it, pal! Leave it to me!",
          "Sure thing! Gimme a sec!",
          "On it! This'll be awesome!",
          "No problem, I'll whip something up!"
        ],
        "fr": [
          "Ça marche, mon pote ! Laisse-moi faire !",
          "Pas de souci ! Une petite seconde !",
          "J'm'en occupe ! Ça va être génial !",
          "Aucun problème, je te prépare ça !"
        ],
        "ja": [
          "任せろって！俺に任せとけ！",
          "オッケー！ちょっと待っててくれよ！",
          "まっかせて！めちゃくちゃいいの作るぜ！",
          "問題なし！すぐ用意するからさ！"
        ],
        "it": [
          "Ricevuto, amico! Lascia fare a me!",
          "Certo! Dammi un secondo!",
          "Ci penso io! Sarà fantastico!",
          "Nessun problema, ti preparo qualcosa!"
        ],
        "es": [
          "¡Hecho, amigo! ¡Déjamelo a mí!",
          "¡Claro! ¡Dame un segundo!",
          "¡Voy! ¡Va a quedar genial!",
          "¡Sin problema, te preparo algo!"
        ]
      }
    }
  },
